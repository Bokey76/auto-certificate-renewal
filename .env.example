# 复制本文件为 .env 后填写。
# .env 含有密钥，已被 .gitignore 排除，不要提交。
# 本仓库是公开仓库，这里只能保留字段名和空值。

# 容器时区。时刻表按这个时区的 03:00 和 15:00 附近运行。
TZ=Asia/Shanghai

# 默认阿里云凭据。任务使用阿里云 DNS 或 CDN 时必填。
# RAM 用户只授予用到的权限：云解析记录读写、yundun-cert:UploadUserCertificate、cdn:SetCdnDomainSSLCertificate。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 可选。任务写成 credential: prod 时读取下面这一组，不再读上面的默认值。
# 后缀是 credential 的大写。多组账号按同样规则追加，不要把真实值写进本文件。
# ALIBABA_CLOUD_ACCESS_KEY_ID_PROD=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET_PROD=

# 可选。容器内配置文件路径，默认 /config/config.yaml。
# CONFIG_PATH=/config/config.yaml
